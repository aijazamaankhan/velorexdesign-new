# Block public HTTP access to dotfiles, dot-directories, and sensitive support files.
# IMPORTANT: .env lives in the project root (next to index.html), and .git/.claude
# directories MUST NOT be web-accessible — otherwise anyone can fetch
# https://your-domain.com/.git/config and download the entire repo + secrets.

# admin.html is only ever read from disk by admin-gate.php, never over HTTP.
# This blocks every spelling of the address, including URL-encoded ones.
<Files "admin.html">
    Require all denied
</Files>

<Files ".env">
    Require all denied
</Files>

<Files ".env.example">
    Require all denied
</Files>

<Files ".gitignore">
    Require all denied
</Files>

# Block any file whose name starts with a dot (e.g. .env, .htaccess, .DS_Store).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block any sensitive extension regardless of folder.
<FilesMatch "\.(log|env|sql|bak|swp|md)$">
    Require all denied
</FilesMatch>

# Block dot-directories entirely (.git, .claude, .vscode, .idea, etc.).
# FilesMatch only matches files, so directories need a RewriteRule.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\." - [F]

    # Repo files that get uploaded with a deploy but are not part of the site
    # (same rule as velorexmusic.com). Must run before the "real file" bailout.
    RewriteRule ^(tests|tasks|docs|Logo|\.playwright-cli)/ - [F,L]
    RewriteRule ^(living-craft-preview\.html)$ - [R=404,L]

    # Admin portal: only reachable through the secret address /manage/<key>
    # (key = ADMIN_PATH_KEY in the server .env). Direct requests for admin.html
    # or the gate script get a plain 404.
    RewriteCond %{THE_REQUEST} \s/+(admin\.html|admin-gate\.php)[\s?/] [NC]
    RewriteRule ^ - [R=404,L]
    RewriteRule ^manage/([A-Za-z0-9_-]+)$ admin-gate.php?k=$1 [L,QSA]
    # Easy, memorable address. The page still needs the admin username and password.
    RewriteRule ^velorex-admin/?$ admin-gate.php?easy=1 [L]
    # Search-engine files, generated so they always carry the live domain.
    RewriteRule ^robots\.txt$ api/robots.php [L]
    RewriteRule ^sitemap\.xml$ api/sitemap.php [L]

    # Serve the WebP copy of a JPG/PNG when the browser accepts WebP and the
    # copy exists (product rows in the database still name the original files).
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_URI} \.(jpe?g|png)$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
    RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,L]

    # ── Real page addresses ────────────────────────────────────────────
    # www and non-www must not both answer, or search engines split the
    # site's ranking between two copies.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # /index.html is the same page as /
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?]
    RewriteRule ^index\.html$ / [R=301,L]

    # Real files and folders (css, js, images, api) are served as they are.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # One address per page: no trailing slash.
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Product, category and fixed pages are filled in by seo-render.php,
    # then the app in js/index.js takes over.
    RewriteRule ^product/([A-Za-z0-9_-]+)$ seo-render.php?_route=product&slug=$1 [L,QSA]
    RewriteRule ^category/([A-Za-z0-9_-]+)$ seo-render.php?_route=category&cat=$1 [L,QSA]
    RewriteRule ^(products|wellness|services|about|contact|faq|shipping|returns|terms|privacy|process|cart|profile|auth)$ seo-render.php?_route=page&page=$1 [L,QSA]
</IfModule>

# Never list folder contents (e.g. the uploaded product images).
Options -Indexes

# Browser-side protections, sent with every page.
<IfModule mod_headers.c>
    # Stops browsers guessing a file type (an "image" being run as a script).
    Header always set X-Content-Type-Options "nosniff"
    # Stops other sites loading this one inside a frame to trick clicks (clickjacking).
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # Keep browsers on HTTPS for a year once they have visited over HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    # Content Security Policy: scripts may only load from this site, so injected
    # markup cannot run code. Styles, fonts and images are limited to the hosts
    # the pages actually use.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    Header always unset X-Powered-By
</IfModule>

# Any other unknown address gets a proper "not found" page with a 404 status.
ErrorDocument 404 /seo-render.php

# ── Speed: compression and browser caching ─────────────────────────────
# CSS and JS links carry ?v=... versions, so they can be cached for a year.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpe?g|png|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpe?g|png)$">
        Header append Vary Accept
    </FilesMatch>
</IfModule>
